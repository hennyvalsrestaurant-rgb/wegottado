{
  "name": "Notification",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "order",
        "promo",
        "system",
        "delivery"
      ],
      "default": "system"
    },
    "read": {
      "type": "boolean",
      "default": false
    },
    "order_id": {
      "type": "string"
    }
  },
  "required": [
    "user_id",
    "title",
    "message"
  ]
}