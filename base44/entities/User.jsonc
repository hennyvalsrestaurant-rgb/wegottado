{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "user"
      ]
    },
    "wallet_balance": {
      "type": "number",
      "description": "Wallet balance in USD available for purchases",
      "default": 0
    }
  },
  "required": [
    "role"
  ]
}