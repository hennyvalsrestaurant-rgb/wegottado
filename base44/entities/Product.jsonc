{
  "name": "Product",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "price": {
      "type": "number"
    },
    "description": {
      "type": "string"
    },
    "image_url": {
      "type": "string"
    },
    "images": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Up to 5 product image URLs"
    },
    "tag": {
      "type": "string"
    },
    "in_stock": {
      "type": "boolean",
      "default": true
    },
    "sizes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Available sizes e.g. XS, S, M, L, XL, XXL"
    }
  },
  "required": [
    "name",
    "price"
  ]
}